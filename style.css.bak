/* ========== 全局 ========== */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  height: 100%;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Comic Sans MS", sans-serif;
  overflow: hidden;
  user-select: none;
  -webkit-user-select: none;
}
.screen { position: absolute; inset: 0; }
.hidden { display: none !important; }
button { font-family: inherit; cursor: pointer; border: none; }

/* ========== 地图场景 ========== */
#map-screen {
  background: linear-gradient(180deg, #8fd3f4 0%, #bfe9ff 45%, #4fb3dd 46%, #2e8fc4 100%);
}
.hud {
  position: absolute; top: 0; left: 0; right: 0; z-index: 30;
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 22px;
}
.hud-title {
  font-size: 26px; font-weight: 800; color: #fff;
  text-shadow: 0 2px 6px rgba(0,60,100,.45);
}
.hud-stats { display: flex; gap: 10px; align-items: center; }
.hud-pill {
  background: rgba(255,255,255,.92); border-radius: 999px;
  padding: 8px 16px; font-size: 17px; font-weight: 700; color: #2c6e9e;
  box-shadow: 0 3px 8px rgba(0,60,100,.25);
}
.hud-btn {
  width: 40px; height: 40px; border-radius: 50%;
  background: rgba(255,255,255,.92); font-size: 18px;
  box-shadow: 0 3px 8px rgba(0,60,100,.25);
  transition: transform .15s;
}
.hud-btn:hover { transform: scale(1.12); }

.island { position: absolute; inset: 0; }

/* 云朵 */
.cloud {
  position: absolute; background: #fff; border-radius: 50px;
  opacity: .92; filter: drop-shadow(0 4px 6px rgba(0,60,100,.15));
}
.cloud::before, .cloud::after {
  content: ""; position: absolute; background: #fff; border-radius: 50%;
}
.cloud-1 { width: 110px; height: 34px; top: 12%; left: 8%; animation: drift1 26s linear infinite; }
.cloud-1::before { width: 48px; height: 48px; top: -22px; left: 16px; }
.cloud-1::after  { width: 34px; height: 34px; top: -12px; right: 18px; }
.cloud-2 { width: 80px; height: 26px; top: 20%; left: 62%; animation: drift2 34s linear infinite; }
.cloud-2::before { width: 36px; height: 36px; top: -16px; left: 12px; }
.cloud-2::after  { width: 26px; height: 26px; top: -9px; right: 14px; }
.cloud-3 { width: 130px; height: 38px; top: 8%; left: 38%; animation: drift3 30s linear infinite; }
.cloud-3::before { width: 54px; height: 54px; top: -26px; left: 22px; }
.cloud-3::after  { width: 38px; height: 38px; top: -14px; right: 22px; }
@keyframes drift1 { 0%{transform:translateX(0)} 50%{transform:translateX(120px)} 100%{transform:translateX(0)} }
@keyframes drift2 { 0%{transform:translateX(0)} 50%{transform:translateX(-90px)} 100%{transform:translateX(0)} }
@keyframes drift3 { 0%{transform:translateX(0)} 50%{transform:translateX(70px)} 100%{transform:translateX(0)} }

/* 海上装饰 */
.sea-deco { position: absolute; font-size: 34px; z-index: 2; }
.sea-deco-1 { bottom: 12%; left: 6%; animation: bob 3.2s ease-in-out infinite; }
.sea-deco-2 { bottom: 20%; right: 8%; animation: bob 4.1s ease-in-out infinite .5s; }
.sea-deco-3 { bottom: 8%; right: 30%; animation: bob 2.8s ease-in-out infinite 1s; }
@keyframes bob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

/* ========== 世界地图：岛屿卡片 ========== */
.world {
  position: absolute; left: 50%; top: 52%; transform: translate(-50%, -50%);
  width: min(96vw, 1180px); height: min(70vh, 600px);
  display: flex; gap: 22px; justify-content: flex-start; justify-content: safe center; align-items: stretch;
  overflow-x: auto; overflow-y: hidden;
  padding: 8px 6px 18px; z-index: 5;
  scroll-snap-type: x proximity;
}
.world::-webkit-scrollbar { height: 8px; }
.world::-webkit-scrollbar-thumb { background: rgba(255,255,255,.65); border-radius: 8px; }
.island-card {
  position: relative; flex: 1 1 200px; min-width: 200px; max-width: 340px;
  scroll-snap-align: center;
  border-radius: 34px;
  background: radial-gradient(ellipse 100% 85% at 50% 42%, #fceabb 0%, #f6d89a 52%, #8bc34a 53%, #6faf3e 78%);
  box-shadow: 0 10px 0 #5d9430, 0 16px 26px rgba(0,60,100,.35);
  padding: 14px 12px 18px;
  display: flex; flex-direction: column;
}
.island-title {
  align-self: center;
  font-size: 21px; font-weight: 800; color: #5d3a17;
  background: rgba(255,255,255,.88); border-radius: 999px;
  padding: 6px 16px; margin-bottom: 6px;
  box-shadow: 0 3px 8px rgba(80,50,20,.25);
  white-space: nowrap;
}
.title-shard { font-size: 18px; }
.title-shard.off { filter: grayscale(1); opacity: .35; }
.island-inner { position: relative; flex: 1; }
.mini-path-svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; }

.island-treasure {
  position: absolute; left: 50%; top: 15%; transform: translate(-50%, -50%);
  font-size: 30px; z-index: 6; filter: grayscale(1) opacity(.5);
  transition: filter .5s;
}
.island-treasure.won {
  filter: none;
  animation: treasureGlow 1.6s ease-in-out infinite;
}
@keyframes treasureGlow {
  0%,100% { transform: translate(-50%,-50%) scale(1);   filter: drop-shadow(0 0 8px gold); }
  50%     { transform: translate(-50%,-58%) scale(1.12); filter: drop-shadow(0 0 22px gold); }
}

/* 未开放岛屿：灰度 + 锁 */
.island-locked { filter: grayscale(.75) brightness(.97); }
.island-lock-overlay {
  position: absolute; inset: 0; z-index: 12; border-radius: 34px;
  background: rgba(50,60,80,.38);
  display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  gap: 6px; padding-bottom: 14px; pointer-events: none;
}
.lock-icon { font-size: 30px; filter: drop-shadow(0 4px 8px rgba(0,0,0,.4)); }
.lock-text {
  color: #fff; font-size: 13px; font-weight: 800; text-align: center; line-height: 1.45;
  background: rgba(0,0,0,.38); border-radius: 12px; padding: 6px 12px;
}

/* ========== 门 ========== */
.door {
  position: absolute; transform: translate(-50%, -100%);
  background: transparent; width: 96px; height: 150px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  transition: transform .2s;
  z-index: 8;
}
.door-arch {
  width: 76px; height: 104px;
  border-radius: 38px 38px 6px 6px;
  border: 5px solid #8a5a2b;
  background: linear-gradient(180deg, #c98a4b, #a06a34);
  display: flex; align-items: center; justify-content: center;
  font-size: 30px;
  box-shadow: inset 0 0 0 3px rgba(255,255,255,.18), 0 6px 10px rgba(80,50,20,.35);
  position: relative;
}
.door-arch::after { /* 门把手 */
  content: ""; position: absolute; right: 12px; top: 55%;
  width: 8px; height: 8px; border-radius: 50%; background: #ffd86b;
  box-shadow: 0 0 4px rgba(255,216,107,.8);
}
.door-label {
  font-size: 13px; font-weight: 800; color: #5d3a17;
  background: rgba(255,255,255,.85); border-radius: 8px;
  padding: 2px 8px; white-space: nowrap;
}
.door-stars { height: 20px; font-size: 15px; letter-spacing: -2px; }

/* 岛内迷你门 */
.door-mini { width: 62px; height: 100px; }
.door-mini .door-arch {
  width: 44px; height: 62px; border-radius: 22px 22px 5px 5px;
  border-width: 4px; font-size: 18px;
}
.door-mini .door-arch::after { right: 7px; width: 6px; height: 6px; }
.door-mini .door-label { font-size: 10.5px; padding: 1px 6px; }
.door-mini .door-stars { height: 15px; font-size: 11px; }

/* 需复习小徽章 */
.door-due {
  position: absolute; top: 4px; right: -4px; z-index: 3;
  width: 24px; height: 24px; border-radius: 50%;
  background: #ff6b81; font-size: 13px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 5px rgba(0,0,0,.3);
  animation: duePulse 1.4s ease-in-out infinite;
}
@keyframes duePulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.18)} }

/* 门状态：已解锁 */
.door-open .door-arch {
  border-color: #ffb830;
  animation: doorPulse 1.8s ease-in-out infinite;
}
@keyframes doorPulse {
  0%,100% { box-shadow: inset 0 0 0 3px rgba(255,255,255,.25), 0 0 10px 2px rgba(255,200,60,.55); }
  50%     { box-shadow: inset 0 0 0 3px rgba(255,255,255,.35), 0 0 26px 8px rgba(255,200,60,.9); }
}
.door-open:hover { transform: translate(-50%, -100%) scale(1.08); }

/* 门状态：已通关 */
.door-cleared .door-arch {
  background: linear-gradient(180deg, #4a3728, #2e231a);
  border-color: #ffd86b;
  box-shadow: inset 0 0 14px rgba(255,216,107,.45), 0 6px 10px rgba(80,50,20,.35);
}
.door-cleared:hover { transform: translate(-50%, -100%) scale(1.06); }

/* 门状态：未解锁 */
.door-locked { filter: grayscale(.85) brightness(.92); opacity: .78; }
.door-locked .door-label { color: #777; }

/* ========== 门的行动菜单 ========== */
.door-menu {
  position: fixed; z-index: 45; background: #fff; border-radius: 18px;
  padding: 12px; box-shadow: 0 12px 30px rgba(0,40,80,.38);
  display: flex; flex-direction: column; gap: 8px; min-width: 180px;
  animation: menuPop .18s ease-out;
}
@keyframes menuPop { 0%{transform:scale(.8);opacity:0} 100%{transform:scale(1);opacity:1} }
.dm-badge {
  background: #ffe9ec; color: #d84a5f; font-size: 13px; font-weight: 800;
  border-radius: 999px; padding: 4px 10px; text-align: center;
}
.dm-title { font-size: 15px; font-weight: 800; color: #5d3a17; text-align: center; }
.dm-btn {
  font-size: 17px; font-weight: 800; padding: 11px 14px; border-radius: 14px;
  color: #fff; transition: transform .12s;
}
.dm-btn:hover { transform: translateY(-2px); }
.dm-quiz { background: linear-gradient(180deg, #ffb830, #ff9a1f); box-shadow: 0 4px 0 #d97e0f; }
.dm-match { background: linear-gradient(180deg, #5fc7ff, #2e9be6); box-shadow: 0 4px 0 #1f78b5; }

/* ========== 向导 ========== */
.guide {
  position: absolute; left: 24px; bottom: 18px; z-index: 20;
  display: flex; align-items: flex-end; gap: 10px;
}
.guide-avatar {
  position: relative; cursor: pointer;
  font-size: 64px; animation: floaty 2.6s ease-in-out infinite;
  filter: drop-shadow(0 6px 8px rgba(0,60,100,.3));
}
@keyframes floaty { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
.guide-bubble {
  max-width: 340px; background: #fff; border-radius: 18px;
  padding: 12px 18px; font-size: 17px; font-weight: 600; color: #33475b;
  box-shadow: 0 6px 16px rgba(0,60,100,.28);
  opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s;
  position: relative; margin-bottom: 24px;
}
.guide-bubble.show { opacity: 1; transform: translateY(0); }
.guide-bubble::after {
  content: ""; position: absolute; left: -10px; bottom: 18px;
  border: 10px solid transparent; border-right-color: #fff; border-left: none;
}

/* ========== 闯关场景 ========== */
#quiz-screen {
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  display: flex; flex-direction: column;
}
.quiz-header {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 22px; color: #fff;
}
.back-btn {
  width: 42px; height: 42px; border-radius: 50%;
  background: rgba(255,255,255,.25); color: #fff; font-size: 18px;
  transition: background .15s, transform .15s;
  flex-shrink: 0;
}
.back-btn:hover { background: rgba(255,255,255,.4); transform: scale(1.08); }
.quiz-door-name { font-size: 22px; font-weight: 800; flex: 1; }
.quiz-dots { display: flex; gap: 7px; flex-wrap: wrap; justify-content: flex-end; }
.quiz-dot {
  width: 15px; height: 15px; border-radius: 50%;
  background: rgba(255,255,255,.32);
  transition: background .3s, transform .3s;
}
.quiz-dot.done { background: #ffd86b; transform: scale(1.15); }

/* 限时答题倒计时条 */
.q-timer {
  height: 12px; margin: 0 22px; border-radius: 999px;
  background: rgba(255,255,255,.25); overflow: hidden;
}
.q-timer-fill {
  height: 100%; width: 100%; border-radius: 999px;
  background: linear-gradient(90deg, #6ee37f, #a6e86e);
}
.q-timer-fill.danger { background: linear-gradient(90deg, #ff7b7b, #ffb347); }

.quiz-body {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 20px;
  padding: 10px 24px 0;
}
.q-type {
  color: rgba(255,255,255,.9); font-size: 18px; font-weight: 600;
  background: rgba(255,255,255,.15); padding: 6px 18px; border-radius: 999px;
}
.q-prompt {
  font-size: clamp(26px, 4.2vw, 44px); font-weight: 800; color: #fff;
  text-align: center; text-shadow: 0 3px 10px rgba(0,0,0,.25);
  max-width: 900px; line-height: 1.35;
}
.q-prompt .phonetic { font-size: .55em; font-weight: 500; opacity: .85; margin-left: 12px; }
.q-prompt.spell { letter-spacing: 6px; }
.q-prompt .spell-hint { display: block; font-size: .5em; letter-spacing: 0; font-weight: 600; margin-top: 10px; opacity: .9; }
.speak-btn {
  background: rgba(255,255,255,.92); color: #5a4fcf;
  font-size: 18px; font-weight: 700; padding: 10px 24px; border-radius: 999px;
  box-shadow: 0 5px 14px rgba(0,0,0,.2); transition: transform .15s;
}
.speak-btn:hover { transform: scale(1.06); }

.q-options {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
  width: min(760px, 92vw);
}
.opt-btn {
  background: #fff; color: #33475b;
  font-size: clamp(17px, 2.4vw, 22px); font-weight: 700;
  padding: 18px 20px; border-radius: 18px; min-height: 68px;
  box-shadow: 0 6px 0 #d3dcf0, 0 8px 16px rgba(0,0,0,.18);
  transition: transform .12s, box-shadow .12s, background .25s;
  word-break: break-word; line-height: 1.3;
}
.opt-btn:hover { transform: translateY(-2px); }
.opt-btn:active { transform: translateY(3px); box-shadow: 0 3px 0 #d3dcf0, 0 4px 8px rgba(0,0,0,.18); }
.opt-btn.opt-correct {
  background: #6ee37f; color: #fff;
  box-shadow: 0 6px 0 #48b95a, 0 0 24px rgba(110,227,127,.8);
  animation: pop .35s;
}
.opt-btn.opt-wrong {
  background: #ff7b7b; color: #fff;
  box-shadow: 0 6px 0 #d45454;
  animation: shake .4s;
}
@keyframes pop { 0%{transform:scale(1)} 45%{transform:scale(1.12)} 100%{transform:scale(1)} }
@keyframes shake {
  0%,100%{transform:translateX(0)} 20%{transform:translateX(-9px)}
  40%{transform:translateX(9px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(6px)}
}

.quiz-guide {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 26px 20px; min-height: 66px;
}
.quiz-guide-avatar { font-size: 38px; }
.quiz-guide-text {
  color: #fff; font-size: 18px; font-weight: 600;
  text-shadow: 0 2px 5px rgba(0,0,0,.3);
}

/* ========== 连连看场景 ========== */
#match-screen {
  background: linear-gradient(180deg, #34c4ac 0%, #1e8f8a 100%);
  display: flex; flex-direction: column;
}
.match-header {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 22px; color: #fff;
}
.match-door-name { font-size: 22px; font-weight: 800; flex: 1; }
.match-round {
  font-size: 16px; font-weight: 700;
  background: rgba(255,255,255,.2); padding: 6px 14px; border-radius: 999px;
}
.match-body {
  flex: 1; position: relative;
  display: flex; justify-content: center; align-items: center;
  gap: min(8vw, 90px); padding: 10px 24px 6px;
}
.match-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 6; }
.match-col {
  display: flex; flex-direction: column; gap: 12px;
  width: min(40vw, 340px); z-index: 7;
}
.match-card {
  background: #fff; color: #33475b;
  font-size: clamp(15px, 2vw, 20px); font-weight: 700;
  padding: 14px 16px; border-radius: 16px; min-height: 56px;
  display: flex; align-items: center; justify-content: center; text-align: center;
  box-shadow: 0 5px 0 #cfd8ea, 0 7px 14px rgba(0,0,0,.18);
  transition: transform .12s, box-shadow .12s, opacity .45s, background .25s;
  word-break: break-word; line-height: 1.3;
}
.match-card:hover { transform: translateY(-2px); }
.match-card.sel { background: #fff3c4; box-shadow: 0 5px 0 #e6c94f, 0 0 0 3px #ffd86b; }
.match-card.matched { opacity: 0; transform: scale(.85); pointer-events: none; }
.match-card.shake { animation: shake .4s; background: #ffd2d2; }
.match-line {
  stroke: #ffd86b; stroke-width: 6; stroke-linecap: round;
  filter: drop-shadow(0 0 6px rgba(255,216,107,.9));
  animation: lineFade .55s ease-out forwards;
}
@keyframes lineFade { 0%{opacity:1} 70%{opacity:1} 100%{opacity:0} }

/* ========== 结算场景 ========== */
#result-screen, #match-result-screen, #chat-result-screen {
  background: rgba(40, 25, 70, .55);
  display: flex; align-items: center; justify-content: center;
  z-index: 50; backdrop-filter: blur(3px);
}
.result-card {
  background: #fff; border-radius: 28px;
  padding: 40px 56px; text-align: center;
  box-shadow: 0 20px 60px rgba(0,0,0,.35);
  animation: resultPop .45s cubic-bezier(.34,1.56,.64,1);
  max-width: 90vw;
}
.match-result-card {
  width: min(720px, 92vw); max-height: 90vh; overflow-y: auto;
  padding: 32px 40px;
}
@keyframes resultPop { 0%{transform:scale(.6);opacity:0} 100%{transform:scale(1);opacity:1} }
.result-emoji { font-size: 76px; animation: floaty 2.2s ease-in-out infinite; }
.result-title { font-size: 34px; color: #4a3a8c; margin: 8px 0; }
.result-stars { font-size: 52px; letter-spacing: 6px; margin: 6px 0; }
.result-msg { font-size: 19px; color: #5a6b7f; margin-bottom: 24px; max-width: 520px; }
.result-btns { display: flex; gap: 14px; justify-content: center; }
.btn-primary, .btn-secondary {
  font-size: 19px; font-weight: 800; padding: 13px 30px; border-radius: 999px;
  transition: transform .15s;
}
.btn-primary {
  background: linear-gradient(180deg, #ffb830, #ff9a1f); color: #fff;
  box-shadow: 0 6px 0 #d97e0f;
}
.btn-secondary {
  background: #eef2fb; color: #5a6b7f;
  box-shadow: 0 6px 0 #ccd6ee;
}
.btn-primary:hover, .btn-secondary:hover { transform: translateY(-2px); }

/* 词族树 */
.family-tree {
  display: flex; flex-direction: column; gap: 12px;
  margin: 4px 0 22px; text-align: left;
}
.family {
  background: #f4f8ff; border-radius: 16px; padding: 12px 16px;
  border-left: 6px solid #7fb2ff;
}
.fam-head { font-size: 17px; color: #33475b; font-weight: 600; }
.fam-head b { color: #4a3a8c; font-size: 20px; }
.fam-head .phonetic { color: #8a98ac; font-size: 14px; }
.fam-pos { color: #8a98ac; font-style: italic; margin: 0 4px; }
.fam-members { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.fam-arrow { color: #7fb2ff; font-weight: 800; }
.fam-member {
  background: #fff; border-radius: 10px; padding: 5px 10px;
  font-size: 15px; color: #55677c;
  box-shadow: 0 2px 5px rgba(0,40,80,.1);
}
.fam-member b { color: #2e7d5b; }
.fam-member i { color: #8a98ac; }

/* ========== 总览场景 ========== */
#overview-screen {
  background: linear-gradient(180deg, #8fd3f4 0%, #bfe9ff 45%, #4fb3dd 46%, #2e8fc4 100%);
  display: flex; flex-direction: column; overflow-y: auto;
}
.ov-header {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 22px; position: sticky; top: 0; z-index: 5;
  background: linear-gradient(180deg, #8fd3f4 72%, rgba(143,211,244,0));
}
.ov-title {
  font-size: 24px; font-weight: 800; color: #fff;
  text-shadow: 0 2px 6px rgba(0,60,100,.45);
}
.ov-body {
  padding: 4px 22px 30px; display: flex; flex-direction: column; gap: 16px;
  width: 100%; max-width: 900px; margin: 0 auto;
}
.ov-summary { display: flex; gap: 12px; flex-wrap: wrap; }
.ov-sum-card {
  flex: 1; min-width: 150px;
  background: rgba(255,255,255,.95); border-radius: 18px; padding: 14px;
  text-align: center; box-shadow: 0 6px 14px rgba(0,60,100,.2);
}
.ov-sum-num { font-size: 28px; font-weight: 800; color: #2c6e9e; }
.ov-sum-label { font-size: 14px; color: #5a6b7f; font-weight: 700; margin-top: 2px; }
.ov-island {
  background: rgba(255,255,255,.95); border-radius: 22px;
  padding: 16px 18px; box-shadow: 0 8px 18px rgba(0,60,100,.2);
}
.ov-island-head {
  display: flex; align-items: center; gap: 8px;
  font-size: 20px; font-weight: 800; color: #33475b; margin-bottom: 2px;
}
.ov-shard { font-size: 20px; }
.ov-shard.off { filter: grayscale(1); opacity: .4; }
.ov-island-prog { font-size: 14px; color: #7a8b9e; font-weight: 700; margin-bottom: 10px; }
.ov-door-row {
  display: grid; grid-template-columns: 1.6fr 1fr 1.2fr 1.2fr;
  gap: 8px; align-items: center;
  padding: 8px 10px; border-radius: 12px;
  font-size: 15px; color: #55677c;
}
.ov-door-row.alt { background: #f2f7ff; }
.ov-door-name { font-weight: 800; color: #33475b; }
.ov-door-stars { letter-spacing: -1px; }
.ov-door-date { font-size: 13px; }
.ov-door-next { font-size: 13px; }
.ov-due {
  display: inline-block;
  color: #fff; background: #ff6b81; font-size: 12px; font-weight: 800;
  border-radius: 999px; padding: 3px 10px; white-space: nowrap;
}
.ov-foot { text-align: center; color: #e8f6ff; font-size: 13px; font-weight: 600; padding: 4px; }

/* ========== 对话模态框 ========== */
.dialogue-overlay {
  background: rgba(30,40,70,.55); z-index: 70;
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(2px);
}
.dlg-card {
  background: #fff; border-radius: 28px; padding: 26px 30px;
  width: min(640px, 92vw);
  display: flex; gap: 20px; align-items: center;
  box-shadow: 0 20px 60px rgba(0,0,0,.4);
  animation: resultPop .35s cubic-bezier(.34,1.56,.64,1);
}
.dlg-left { display: flex; flex-direction: column; align-items: center; gap: 4px; flex-shrink: 0; }
.dlg-avatar { font-size: 84px; animation: floaty 2.4s ease-in-out infinite; }
.dlg-name {
  font-size: 18px; font-weight: 800; color: #4a3a8c;
  background: #f0ecff; border-radius: 999px; padding: 3px 16px;
}
.dlg-right { flex: 1; display: flex; flex-direction: column; gap: 16px; }
.dlg-text {
  font-size: 21px; font-weight: 700; color: #33475b;
  line-height: 1.6; min-height: 70px;
}
.dlg-next { align-self: flex-end; }

/* ========== 设置面板 ========== */
.settings-overlay {
  background: rgba(30,40,70,.55); z-index: 60;
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(2px);
}
.settings-card {
  background: #fff; border-radius: 26px; padding: 26px 30px;
  width: min(520px, 92vw); max-height: 90vh; overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0,0,0,.4);
  animation: resultPop .35s cubic-bezier(.34,1.56,.64,1);
}
.settings-card h2 { color: #4a3a8c; margin-bottom: 14px; font-size: 26px; }
.set-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; padding: 12px 0;
  border-bottom: 2px dashed #eef2fb;
}
.set-col { flex-direction: column; align-items: stretch; }
.set-label { font-size: 17px; font-weight: 800; color: #33475b; }
.set-voice-row { display: flex; gap: 10px; }
#set-voice {
  flex: 1; min-width: 0;
  font-size: 15px; font-family: inherit;
  padding: 9px 10px; border-radius: 12px; border: 2px solid #dbe4f5;
  background: #fff; color: #33475b;
}
.set-test-btn { padding: 8px 18px; font-size: 15px; flex-shrink: 0; }
#set-rate { width: 100%; accent-color: #5a7fff; }
.seg-btns { display: flex; gap: 8px; }
.seg-btns button {
  flex: 1; font-size: 16px; font-weight: 800; padding: 10px;
  border-radius: 12px; background: #eef2fb; color: #5a6b7f;
  box-shadow: 0 3px 0 #ccd6ee; transition: all .15s;
}
.seg-btns button.active {
  background: linear-gradient(180deg, #ffb830, #ff9a1f); color: #fff;
  box-shadow: 0 3px 0 #d97e0f;
}
.toggle-btn {
  font-size: 16px; font-weight: 800; padding: 9px 22px; border-radius: 999px;
  background: #6ee37f; color: #fff; box-shadow: 0 4px 0 #48b95a;
  min-width: 84px; flex-shrink: 0;
}
.toggle-btn.off { background: #b9c4d6; box-shadow: 0 4px 0 #97a4ba; }
.btn-danger {
  background: #ff7b7b; color: #fff; font-size: 16px; font-weight: 800;
  padding: 11px 20px; border-radius: 14px; box-shadow: 0 4px 0 #d45454;
  width: 100%;
}
.set-close { width: 100%; margin-top: 16px; }

/* ========== 星星爆裂特效 ========== */
.star-burst {
  position: fixed; z-index: 99; font-size: 22px; pointer-events: none;
  animation: burst .9s ease-out forwards;
}
@keyframes burst {
  0%   { transform: translate(0,0) scale(.4); opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(1.3); opacity: 0; }
}

/* ========== 精灵碎片飞入动画 ========== */
.shard-fly {
  position: fixed; z-index: 99; font-size: 44px; pointer-events: none;
  animation: shardFly 1.15s cubic-bezier(.5,-.3,.7,1) forwards;
}
@keyframes shardFly {
  0%   { transform: translate(0,0) scale(.4); opacity: 0; }
  20%  { transform: translate(0,-46px) scale(1.4); opacity: 1; }
  100% { transform: translate(var(--tx), var(--ty)) scale(.5); opacity: .9; }
}

/* ========== 英语对话场景（和泡泡聊天） ========== */
#chat-screen {
  background: linear-gradient(180deg, #f7709e 0%, #b06ab3 100%);
  display: flex; flex-direction: column;
}
.chat-header {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 22px; color: #fff;
}
.chat-title { font-size: 22px; font-weight: 800; flex: 1; }
.chat-body {
  flex: 1; overflow-y: auto;
  display: flex; flex-direction: column; gap: 12px;
  padding: 6px 22px 12px;
}
.chat-row { display: flex; align-items: flex-end; gap: 8px; animation: chatIn .35s ease-out; }
.chat-row.right { justify-content: flex-end; }
@keyframes chatIn { 0%{opacity:0; transform:translateY(12px)} 100%{opacity:1; transform:translateY(0)} }
.chat-avatar {
  width: 42px; height: 42px; border-radius: 50%; background: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 26px;
  box-shadow: 0 3px 8px rgba(0,0,0,.2); flex-shrink: 0;
}
.chat-bubble {
  max-width: min(72%, 560px); background: #fff; color: #33475b;
  border-radius: 16px; padding: 10px 14px;
  font-size: 18px; font-weight: 700; line-height: 1.45;
  box-shadow: 0 4px 10px rgba(0,0,0,.16);
}
.chat-row.left .chat-bubble { border-bottom-left-radius: 4px; cursor: pointer; }
.chat-row.right .chat-bubble { background: #95ec69; border-bottom-right-radius: 4px; }
.chat-rep-label { font-size: 13px; font-weight: 800; color: #f7709e; margin-bottom: 3px; }
.chat-listen {
  width: 30px; height: 30px; border-radius: 50%;
  background: #eef2fb; font-size: 15px; margin-left: 8px; vertical-align: middle;
}
.chat-zh { display: none; margin-top: 6px; font-size: 14.5px; font-weight: 600; color: #7a8b9e; }
.chat-bubble.zh-open .chat-zh { display: block; }
.chat-zh-tip { display: block; margin-top: 5px; font-size: 12.5px; font-weight: 700; color: #aab8c8; }
.chat-bubble.zh-open .chat-zh-tip { display: none; }

.chat-input {
  display: flex; flex-direction: column; gap: 10px; justify-content: flex-end;
  min-height: 104px; padding: 8px 22px 22px;
}
.chat-hint {
  min-height: 24px; text-align: center;
  color: #fff; font-size: 17px; font-weight: 800;
  text-shadow: 0 2px 5px rgba(0,0,0,.3);
}
.chat-hint.good { color: #d9ffd2; }
.chat-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.chat-btn {
  background: #fff; color: #33475b; font-size: 17px; font-weight: 800;
  padding: 12px 22px; border-radius: 999px;
  box-shadow: 0 5px 0 #d3dcf0, 0 7px 14px rgba(0,0,0,.18);
  transition: transform .12s, box-shadow .12s, opacity .2s;
}
.chat-btn:hover { transform: translateY(-2px); }
.chat-btn:active { transform: translateY(2px); box-shadow: 0 3px 0 #d3dcf0; }
.chat-btn:disabled { opacity: .55; transform: none; cursor: default; }
.chat-btn.primary {
  background: linear-gradient(180deg, #ffb830, #ff9a1f); color: #fff;
  box-shadow: 0 5px 0 #d97e0f;
}
.chat-btn.primary:active { box-shadow: 0 3px 0 #d97e0f; }
.chat-btn.mic-on {
  background: #ffe9ec; color: #d84a5f; box-shadow: 0 5px 0 #eab0ba;
  animation: micPulse 1s ease-in-out infinite;
}
@keyframes micPulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.07)} }
.chat-opt small { display: block; font-size: 13px; font-weight: 600; color: #8a98ac; margin-top: 3px; }
.chat-opt.wrong-pick { opacity: .45; }

/* 话题选择菜单（点泡泡头像弹出） */
.chat-menu { min-width: 250px; }
.chat-topic {
  background: linear-gradient(180deg, #6fdc9f, #3bb56d);
  box-shadow: 0 4px 0 #2a8f52;
  text-align: left; font-size: 15px; line-height: 1.4;
}
.chat-topic.topic-locked {
  background: #c3cede; box-shadow: 0 4px 0 #a4b0c4;
  color: #f2f5fa; cursor: default;
}

/* ========== 星星商店 ========== */
#shop-screen {
  background: linear-gradient(180deg, #ffa751 0%, #ff5e7e 100%);
  display: flex; flex-direction: column;
}
.shop-header {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 22px; color: #fff;
}
.shop-title {
  font-size: 22px; font-weight: 800; flex: 1;
  text-shadow: 0 2px 6px rgba(0,0,0,.25);
}
.shop-body {
  flex: 1; overflow-y: auto;
  display: flex; flex-direction: column; gap: 14px;
  width: 100%; max-width: 980px; margin: 0 auto;
  padding: 4px 22px 90px;
}
.shop-sec-title {
  color: #fff; font-size: 19px; font-weight: 800;
  text-shadow: 0 2px 5px rgba(0,0,0,.25); margin-top: 8px;
}
.shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
.shop-card {
  position: relative;
  background: rgba(255,255,255,.96); border-radius: 20px;
  padding: 16px 12px 14px;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  box-shadow: 0 8px 16px rgba(0,0,0,.18);
  animation: chatIn .3s ease-out;
}
.shop-card.equipped { box-shadow: 0 0 0 4px #6ee37f, 0 8px 16px rgba(0,0,0,.18); }
.shop-icon { font-size: 46px; }
.shop-name { font-size: 16.5px; font-weight: 800; color: #33475b; }
.shop-price {
  font-size: 14px; font-weight: 800; color: #b8860b;
  background: #fff6d8; border-radius: 999px; padding: 3px 12px;
}
.shop-price.owned { color: #3f9e4d; background: #e6f9ea; }
.shop-btn {
  font-size: 15.5px; font-weight: 800; padding: 9px 20px; border-radius: 999px;
  background: linear-gradient(180deg, #ffb830, #ff9a1f); color: #fff;
  box-shadow: 0 4px 0 #d97e0f; transition: transform .12s;
}
.shop-btn:hover { transform: translateY(-2px); }
.shop-btn:disabled { background: #c3cede; box-shadow: 0 4px 0 #a4b0c4; transform: none; cursor: default; }
.shop-btn.equip { background: linear-gradient(180deg, #5fc7ff, #2e9be6); box-shadow: 0 4px 0 #1f78b5; }
.shop-btn.unequip { background: #eef2fb; color: #5a6b7f; box-shadow: 0 4px 0 #ccd6ee; }
.shop-badge {
  position: absolute; top: -8px; right: -6px;
  background: #6ee37f; color: #fff; font-size: 12px; font-weight: 800;
  border-radius: 999px; padding: 3px 10px; box-shadow: 0 3px 6px rgba(0,0,0,.2);
}
.shop-toast {
  position: absolute; left: 50%; bottom: 26px; z-index: 20;
  transform: translateX(-50%) translateY(10px);
  background: #fff; color: #33475b; font-size: 16px; font-weight: 800;
  border-radius: 999px; padding: 12px 26px;
  box-shadow: 0 8px 20px rgba(0,0,0,.3);
  opacity: 0; pointer-events: none;
  transition: opacity .3s, transform .3s;
}
.shop-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ========== 向导装扮 & 地图装饰（商店装备效果） ========== */
.guide-acc {
  position: absolute; top: -12px; right: -10px; font-size: 28px;
  filter: drop-shadow(0 2px 3px rgba(0,60,100,.35));
}
.guide-pet {
  font-size: 38px; align-self: flex-end; margin-bottom: 8px;
  animation: floaty 2.6s ease-in-out infinite .5s;
  filter: drop-shadow(0 5px 7px rgba(0,60,100,.3));
}
.map-decos { position: absolute; inset: 0; z-index: 6; pointer-events: none; }
.map-deco { position: absolute; filter: drop-shadow(0 5px 8px rgba(0,60,100,.3)); }
.map-deco.deco-rainbow { top: 2.5%; left: 62%; font-size: 66px; animation: bob 4.5s ease-in-out infinite; }
.map-deco.deco-fountain { bottom: 2.5%; right: 16%; font-size: 56px; }
.map-deco.deco-castle { bottom: 2.5%; right: 3.5%; font-size: 62px; }

/* ========== 小屏适配 ========== */
@media (max-width: 720px) {
  .hud-title { font-size: 20px; }
  .hud-pill { font-size: 14px; padding: 6px 12px; }
  .world {
    flex-direction: column; align-items: center;
    overflow-y: auto; overflow-x: hidden;
    left: 50%; top: 64px; bottom: 96px; height: auto;
    transform: translateX(-50%);
  }
  .island-card { flex: none; width: min(90vw, 360px); min-height: 320px; }
  .guide-avatar { font-size: 48px; }
  .guide-bubble { font-size: 15px; max-width: 62vw; }
  .q-options { grid-template-columns: 1fr; }
  .match-body { gap: 5vw; padding: 8px 12px; }
  .match-col { width: 44vw; gap: 9px; }
  .match-card { padding: 10px 10px; min-height: 48px; }
  .ov-door-row { grid-template-columns: 1.5fr .9fr 1fr 1fr; font-size: 12.5px; gap: 4px; padding: 7px 6px; }
  .dlg-card { flex-direction: column; text-align: center; padding: 22px; }
  .dlg-avatar { font-size: 64px; }
  .dlg-text { font-size: 18px; min-height: 0; }
  .dlg-next { align-self: center; }
  .settings-card { padding: 22px; }
  .result-card { padding: 30px 26px; }
  .chat-bubble { font-size: 16px; max-width: 82%; }
  .chat-avatar { width: 36px; height: 36px; font-size: 22px; }
  .shop-grid { grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; }
  .map-deco.deco-rainbow { font-size: 46px; left: 54%; }
  .map-deco.deco-fountain { font-size: 42px; }
  .map-deco.deco-castle { font-size: 46px; }
  .guide-pet { font-size: 30px; }
}

/* ========== 默写训练营场景 ========== */
#dictation-screen {
  background: linear-gradient(180deg, #f093fb 0%, #f5576c 100%);
  display: flex; flex-direction: column;
}
.dict-header {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 22px; color: #fff;
}
.dict-door-name { font-size: 20px; font-weight: 800; flex: 1; }
.dict-meta { display: flex; gap: 12px; align-items: center; }
.dict-level {
  font-size: 14px; font-weight: 800;
  background: rgba(255,255,255,.25); padding: 5px 14px; border-radius: 999px;
}
.dict-progress {
  font-size: 14px; font-weight: 700;
  background: rgba(255,255,255,.25); padding: 5px 14px; border-radius: 999px;
}
.dict-body {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 20px;
  padding: 10px 24px 0;
}
.dict-meaning {
  font-size: clamp(22px, 3.5vw, 34px); font-weight: 800; color: #fff;
  text-align: center; text-shadow: 0 2px 8px rgba(0,0,0,.2);
  max-width: 800px;
}
.dict-input-area {
  display: flex; flex-direction: column; align-items: center; gap: 18px;
  width: 100%; max-width: 760px;
}
.dict-word {
  font-size: clamp(32px, 5vw, 56px); font-weight: 800; color: #fff;
  letter-spacing: 4px; text-shadow: 0 3px 10px rgba(0,0,0,.25);
  display: flex; flex-wrap: wrap; justify-content: center; gap: 2px;
}
.dict-char { min-width: 18px; text-align: center; }
.dict-blank {
  display: inline-block; min-width: 36px; text-align: center;
  border-bottom: 4px solid #fff; color: #ffd86b;
  font-size: 1em; font-weight: 800;
  transition: color .3s, border-color .3s;
}
.dict-blank.blank-ok { color: #6ee37f; border-color: #6ee37f; }
.dict-blank.blank-wrong { color: #ff7b7b; border-color: #ff7b7b; }

.dict-alpha {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
  max-width: 680px; padding: 4px;
}
.dict-alpha-btn {
  width: 42px; height: 42px; border-radius: 10px;
  background: rgba(255,255,255,.92); color: #33475b;
  font-size: 17px; font-weight: 800;
  box-shadow: 0 4px 0 #d3dcf0, 0 6px 12px rgba(0,0,0,.18);
  transition: transform .12s;
}
.dict-alpha-btn:hover { transform: translateY(-2px); }
.dict-alpha-btn:active { transform: translateY(2px); }

/* L2 字母块 */
.dict-tile-row {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;
}
.dict-tile {
  width: 52px; height: 52px; border-radius: 12px;
  background: rgba(255,255,255,.95); color: #33475b;
  font-size: 22px; font-weight: 800;
  box-shadow: 0 5px 0 #d3dcf0, 0 7px 14px rgba(0,0,0,.18);
  transition: transform .12s, opacity .3s;
}
.dict-tile:hover { transform: translateY(-2px); }
.dict-tile:active { transform: translateY(2px); }
.dict-tile.tile-used { opacity: .35; transform: none; }
.dict-tile.tile-shake { animation: shake .4s; background: #ffd2d2; }
.dict-tile-answer {
  min-height: 40px; font-size: 28px; font-weight: 800; color: #fff;
  letter-spacing: 3px; text-shadow: 0 2px 6px rgba(0,0,0,.2);
}
.dict-tile-answer.answer-ok { color: #d9ffd2; }

/* L3 听音默写 */
.dict-l3-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
.dict-l3-mean {
  font-size: 22px; font-weight: 700; color: #fff;
  text-shadow: 0 2px 6px rgba(0,0,0,.2);
}
.dict-input {
  width: min(480px, 88vw); padding: 14px 20px; border-radius: 16px;
  border: 3px solid rgba(255,255,255,.5); background: rgba(255,255,255,.92);
  font-size: 22px; font-weight: 700; color: #33475b;
  text-align: center; outline: none;
  box-shadow: 0 6px 16px rgba(0,0,0,.2);
}
.dict-input:focus { border-color: #ffd86b; }
.dict-submit { margin-top: 6px; }

.dictation-feedback {
  min-height: 40px; text-align: center;
  color: #fff; font-size: 18px; font-weight: 700;
  text-shadow: 0 2px 5px rgba(0,0,0,.3);
  padding: 0 20px;
}
.dictation-feedback.feedback-ok { color: #d9ffd2; }
.dictation-feedback.feedback-wrong { color: #ffe9ec; }

.dict-compare { display: flex; flex-wrap: wrap; justify-content: center; gap: 2px; margin-top: 8px; }
.cmp-same { color: #6ee37f; font-weight: 800; }
.cmp-wrong { color: #ff7b7b; font-weight: 800; text-decoration: line-through; }
.cmp-right { color: #d9ffd2; font-weight: 800; }

/* 默写结算 */
#dictation-result-screen { background: rgba(40, 25, 70, .55); display: flex; align-items: center; justify-content: center; z-index: 50; backdrop-filter: blur(3px); }
.dict-result-level { font-size: 16px; color: #8a98ac; font-weight: 700; margin-top: -4px; }
.dict-result-door { font-size: 15px; color: #6a7b8f; font-weight: 700; margin-bottom: 4px; }
.dict-result-list { max-height: 42vh; overflow-y: auto; text-align: left; margin: 10px 0; width: 100%; }
.dict-result-sec { margin-bottom: 12px; }
.dict-result-label { font-size: 15px; font-weight: 800; color: #5a6b7f; margin-bottom: 6px; }
.dict-result-tag { display: inline-block; background: #e6f9ea; color: #3f9e4d; font-size: 15px; font-weight: 700; padding: 5px 12px; border-radius: 10px; margin: 3px; }
.dict-result-wrong-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 8px 12px; background: #fff0f2; border-radius: 12px; margin: 4px 0; }
.dict-result-w { font-size: 17px; font-weight: 800; color: #33475b; }
.dict-result-m { font-size: 14px; color: #7a8b9e; }
.dict-result-u { font-size: 13px; color: #ff6b81; font-weight: 700; }

/* ========== 自由聊天室 ========== */
#freechat-screen {
  background: linear-gradient(180deg, #f7709e 0%, #b06ab3 100%);
  display: flex; flex-direction: column;
}
.fc-input-wrap {
  display: flex; gap: 10px; align-items: center;
  padding: 8px 22px 22px;
}
.fc-text {
  flex: 1; padding: 12px 18px; border-radius: 999px;
  border: 2px solid rgba(255,255,255,.4); background: rgba(255,255,255,.92);
  font-size: 17px; font-weight: 600; color: #33475b; outline: none;
}
.fc-text:focus { border-color: #ffd86b; }

/* ========== 总览薄弱词板块 ========== */
.ov-weak-list { margin-top: 8px; }
.ov-weak-row {
  display: grid; grid-template-columns: 1.4fr 1.2fr .7fr 1fr;
  gap: 8px; align-items: center;
  padding: 8px 10px; border-radius: 10px;
  font-size: 14px; color: #55677c; cursor: pointer;
  transition: background .15s;
}
.ov-weak-row:hover { background: #f0ecff; }
.ov-weak-row.alt { background: #f8f6ff; }
.ov-weak-text { font-weight: 800; color: #33475b; }
.ov-weak-mean { color: #7a8b9e; }
.ov-weak-count { color: #ff6b81; font-weight: 800; font-size: 13px; }
.ov-weak-island { color: #5a6b7f; font-size: 13px; text-align: right; }

/* ========== 门菜单第三按钮 ========== */
.dm-dict { background: linear-gradient(180deg, #f093fb, #f5576c); box-shadow: 0 4px 0 #c73e5a; }

/* ========== ask 步骤输入框 ========== */
.chat-input-wrap { display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; }
.chat-text-input {
  flex: 1; min-width: 160px; max-width: 400px;
  padding: 12px 18px; border-radius: 999px;
  border: 2px solid rgba(255,255,255,.4); background: rgba(255,255,255,.92);
  font-size: 16px; font-weight: 600; color: #33475b; outline: none;
}
.chat-text-input:focus { border-color: #ffd86b; }

/* ========== 小屏适配新增 ========== */
@media (max-width: 720px) {
  .dict-word { font-size: 26px; letter-spacing: 2px; }
  .dict-alpha-btn { width: 34px; height: 34px; font-size: 14px; }
  .dict-tile { width: 42px; height: 42px; font-size: 18px; }
  .dict-input { font-size: 18px; padding: 12px 16px; }
  .fc-text { font-size: 15px; padding: 10px 14px; }
  .ov-weak-row { grid-template-columns: 1fr 1fr; gap: 4px; padding: 7px 8px; }
  .ov-weak-island { display: none; }
  .chat-text-input { min-width: 120px; padding: 10px 14px; }
}
